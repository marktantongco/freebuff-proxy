# freebuff-proxy — environment template (README.env)
#
# Copy this file to `.env` (gitignored) or export the values in your shell /
# systemd service before running `freebuff-proxy serve`.
#
# Process env vars take precedence over `.env` entries.

# ── Core ────────────────────────────────────────────────────────────────────
# HTTP listen address for the proxy itself.
FREEBUFF_PROXY_ADDR=127.0.0.1:1455

# Freebuff/Codebuff upstream API base URL.
FREEBUFF_API_BASE_URL=https://www.codebuff.com

# Model advertised by /v1/models and used by sample requests.
FREEBUFF_MODEL=deepseek/deepseek-v4-pro

# When set, every endpoint requires `Authorization: Bearer <value>` or
# `x-api-key: <value>`. Also read by the dashboard's DefaultProxyTargets to
# authenticate health probes. Without it, dashboard probes skip auth.
FREEBUFF_PROXY_API_KEY=

# Credential file written after `login` and read during `serve`.
FREEBUFF_CREDENTIALS_PATH=$HOME/.config/manicode/credentials.json

# ── Multi-token rotation ────────────────────────────────────────────────────
# Comma-separated Freebuff auth tokens. Sessions are acquired across these
# tokens round-robin; token_pool stats appear in /healthz and the dashboard.
AUTH_TOKENS=

# ── Stealth transport (JA3 TLS fingerprint impersonation) ───────────────────
# Default is false (opt-in). Set to true to enable the uTLS stealth transport.
STEALTH_ENABLED=true

# Browser fingerprint: chrome120 | firefox120 | safari17 | random.
STEALTH_PROFILE=chrome120

# SOCKS5 proxy URL or Webshare proxy-list URL for outbound rotation.
PROXY_URL=

# How often the proxy pool refreshes (minutes, default 30).
PROXY_REFRESH_MINS=30

# Fail-closed: only accept US proxies (default false).
PROXY_STRICT_GEO=false

# Geo-verify proxy countries via ip-api.com batch API (default false).
PROXY_GEO_VERIFY=false

# ── Monitoring dashboard ────────────────────────────────────────────────────
# Set to false to disable the built-in dashboard (default true).
DASHBOARD_ENABLED=true

# Dashboard listen address (default :9091).
#
# IMPORTANT — one dashboard port per proxy instance:
#   * main instance (:1455)          -> DASHBOARD_ADDR=:9091
#   * second instance (:8080)        -> DASHBOARD_ADDR=:9092
#   * every additional instance      -> pick the next free port (:9093, :9094, …)
# Each instance must use a UNIQUE dashboard address, otherwise the second
# instance fails to bind with "address already in use".
DASHBOARD_ADDR=:9091

# URL path prefix (default /dashboard). API lives at <prefix>/api/status.
DASHBOARD_PREFIX=/dashboard

# ── Example: full second-instance profile (port 8080, dashboard :9092) ──────
# FREEBUFF_PROXY_ADDR=0.0.0.0:8080
# FREEBUFF_PROXY_API_KEY=your-key
# AUTH_TOKENS=token1,token2
# STEALTH_ENABLED=true
# STEALTH_PROFILE=chrome120
# DASHBOARD_ENABLED=true
# DASHBOARD_ADDR=:9092
